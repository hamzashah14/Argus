# Copy to config.env (git-ignored) and fill it in. Read by setup-iam.sh,
# setup-lambdas.sh, deploy.sh and setup-alerts.sh. Keep one setting per line,
# LF line endings, no spaces around "=".
#
# Anything marked REQUIRED has no default on purpose: a wrong guess for these
# doesn't error, it silently monitors nothing.

# ---------------------------------------------------------------------------
# REQUIRED — regions
# ---------------------------------------------------------------------------
# Where your EC2 instances run. Their CloudWatch logs/metrics, the alarms,
# SNS topics, EventBridge rule and the trigger Lambda all live here.
MONITOR_REGION=

# Where the Bedrock Agent and its two tool Lambdas run. Must be a region where
# Bedrock Agents and your chosen model are available. Can equal MONITOR_REGION.
BEDROCK_REGION=

# ---------------------------------------------------------------------------
# REQUIRED for deploy.sh
# ---------------------------------------------------------------------------
# Foundation-model ID or inference-profile ID. Confirm it is listed as
# supported for Bedrock Agents in BEDROCK_REGION before using it.
BEDROCK_MODEL_ID=

# ---------------------------------------------------------------------------
# REQUIRED for setup-alerts.sh (fill in after deploy.sh + creating an alias)
# ---------------------------------------------------------------------------
BEDROCK_AGENT_ID=
# A versioned alias you create (not TSTALIASID, which tracks the editable draft).
BEDROCK_AGENT_ALIAS_ID=
ALERT_EMAIL=
# Comma-separated. Every run must list ALL monitored instances: the EC2
# stop/terminate rule is rewritten to exactly this list each time.
INSTANCE_IDS=

# ---------------------------------------------------------------------------
# Optional — defaults shown
# ---------------------------------------------------------------------------
# Container names whose awslogs log groups (<prefix>/<instance-id>/<name>)
# should be pre-created with retention, e.g. mobilebff,webbff,sso
CONTAINER_NAMES=
LOG_GROUP_PREFIX=/aiops
# Must be a value CloudWatch accepts: 1,3,5,7,14,30,60,90,120,150,180,365,...
LOG_RETENTION_DAYS=30
AGENT_NAME=aiops-assistant

ENABLE_RESOURCE_ALARMS=true
CPU_THRESHOLD=90
MEM_THRESHOLD=90
DISK_THRESHOLD=85
DISK_PATH=/

ENABLE_NGINX_ALARM=true
# 502/504 responses (access log) + upstream failures (error log) per minute
# needed to count a minute as bad; alarm fires on 2 bad minutes out of 3.
NGINX_ERROR_THRESHOLD=5
# Matches the status field of nginx's default "combined" log_format. If your
# log_format differs, change this — see README "Verify the Nginx filter".
NGINX_ACCESS_FILTER_PATTERN='[ip, ident, user, timestamp, request, status_code = 502 || status_code = 504, bytes, referer, agent]'
NGINX_ERROR_FILTER_PATTERN='?"upstream timed out" ?"no live upstreams" ?"connect() failed"'

# Needs the CWAgent procstat plugin configured on the instance.
ENABLE_PROCESS_ALARM=false

# Caps parallel automatic investigations (and so Bedrock spend during an
# alarm storm). Leave empty to skip — new AWS accounts with a concurrency
# quota of 10 can't reserve any.
TRIGGER_RESERVED_CONCURRENCY=2

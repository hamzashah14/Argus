{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "environment",
    "account_id",
    "monitor_region",
    "bedrock_region",
    "release_id",
    "model_id",
    "model_arns",
    "executor_mode",
    "notification_email",
    "reserved_concurrency",
    "maintenance_mode",
    "log_retention_days",
    "rollback_days",
    "ui_principal_arn",
    "ci_principal_arn",
    "deployment_role_arn",
    "instances",
    "nginx_filters",
    "log_segment",
    "reference_only"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}$"
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "monitor_region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "bedrock_region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,15}$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "model_arns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^arn:aws:bedrock:[a-z0-9-]+:(?:[0-9]{12})?:(?:foundation-model|inference-profile|application-inference-profile)/[A-Za-z0-9.:-]+$"
      }
    },
    "executor_mode": {
      "enum": [
        "qualified"
      ]
    },
    "notification_email": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    "reserved_concurrency": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      ]
    },
    "maintenance_mode": {
      "type": "boolean"
    },
    "log_retention_days": {
      "enum": [
        7,
        14,
        30,
        60,
        90,
        180,
        365
      ]
    },
    "rollback_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 90
    },
    "ui_principal_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "ci_principal_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "deployment_role_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "log_groups",
          "disk_path",
          "resource_alarms",
          "nginx_alarm",
          "process_exe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i-(?:[a-f0-9]{8}|[a-f0-9]{17})$"
          },
          "log_groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            }
          },
          "disk_path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_-]*$"
          },
          "resource_alarms": {
            "type": "boolean"
          },
          "nginx_alarm": {
            "type": "boolean"
          },
          "process_exe": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,40}$"
              }
            ]
          }
        }
      }
    },
    "nginx_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "error"
      ],
      "properties": {
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "match",
            "miss"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "miss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "match",
            "miss"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "miss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "log_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{0,24}$"
    },
    "reference_only": {
      "type": "boolean"
    },
    "observability": {
      "type": "object"
    }
  }
}

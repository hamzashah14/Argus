# Chat UI settings. Locally: copy to .env (git-ignored). On Render: set each
# one as an environment variable instead.

# REQUIRED
BEDROCK_REGION=
BEDROCK_AGENT_ID=
# A versioned alias you created in Bedrock (not TSTALIASID).
BEDROCK_AGENT_ALIAS_ID=
# At least 12 characters. The UI refuses to start without it.
APP_PASSWORD=

# On Render: keys for an IAM user allowed ONLY bedrock:InvokeAgent on the
# alias above (see README). Locally: omit to use your AWS CLI profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

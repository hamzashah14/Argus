# Customer-operated web UI. Copy to ignored .env or configure workload environment.
# Paste values from the reviewed routing stack's RuntimeConnection output.
APP_PASSWORD=
ENVIRONMENT=development
RUNTIME_TARGET=standalone
BEDROCK_REGION=
BEDROCK_MODEL_ID=
EXPECTED_ACCOUNT_ID=
ALLOWED_INSTANCE_IDS=
# Numeric, immutable Lambda versions in BEDROCK_REGION (standalone execution).
LOGS_TOOL_ARN=
METRICS_TOOL_ARN=
# Exact release fingerprint from RuntimeConnection; never invent a value.
RUNTIME_RELEASE=
RUNTIME_LIMITS={"tokens_reserved":32000,"model_steps":8,"tool_calls":8,"log_queries":24,"output_tokens":1024,"window_minutes":15,"context_bytes":48000,"tool_bytes":20000}
# For RUNTIME_TARGET=agentcore, select the reviewed immutable release endpoint.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_ENDPOINT=
# Production UI invokes only the isolated qualified chat gateway in MONITOR_REGION.
CHAT_FUNCTION_ARN=
# Use the AWS credential chain: local SSO/profile, assumed role or workload role.
# AWS_PROFILE=default
# Optional incident status access; values from the durable foundation outputs.
MONITOR_REGION=
INCIDENT_TABLE=
REPORT_BUCKET=
# Existing eligible deployments only: RUNTIME_TARGET=classic and agent ID/alias.
# BEDROCK_AGENT_ID=
# BEDROCK_AGENT_ALIAS_ID=
# Phase 5 individual identity; use verified identity-enabled RuntimeConnection.
# Staging/production require OIDC even if APP_PASSWORD is set.
# KIRA_AUTH_MODE=oidc
# KIRA_ACCESS_POLICY_JSON=  # exact rendered policy; do not also set a policy file
# KIRA_SESSION_TABLE=
# KIRA_SESSION_KEY_ARN=
# KIRA_SESSION_KEY_VERSION=  # immutable version; never AWSCURRENT
# KIRA_STAGING_TICKET_FILE=  # optional local operator-only private canary export
# Native provider settings belong in ignored .streamlit/secrets.toml.

# KIRA_WORK_POLICY and KIRA_DIAGNOSTIC_POLICY are emitted by the reviewed RuntimeConnection.
# Copy their exact values; see docs/implementation/phase-5/LOCAL_COMPLETION.md.
